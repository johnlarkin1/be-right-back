      "link": null,
      "locked": false,
      "index": "b09",
      "text": "Flow 1: Contacts Query\n\nFrontend: invoke('get_all_contacts')\n  \u2192 Tauri: routes to registered handler\n  \u2192 Rust: queries SQLite metadata DB\n  \u2192 returns Contact[] (serialized JSON)\n  \u2190 Frontend: updates Zustand store",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "box-flow1",
      "originalText": "Flow 1: Contacts Query\n\nFrontend: invoke('get_all_contacts')\n  \u2192 Tauri: routes to registered handler\n  \u2192 Rust: queries SQLite metadata DB\n  \u2192 returns Contact[] (serialized JSON)\n  \u2190 Frontend: updates Zustand store",
      "autoResize": true,
      "lineHeight": 1.25
    },
