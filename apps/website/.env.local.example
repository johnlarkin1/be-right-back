# PostHog — Be Right Back marketing site analytics and feature flags.
#
# These also drive the homepage kill switch: `/` resolves the
# `website-holding-page` flag server-side, and serves the ComingSoon holding
# page only when PostHog explicitly says to. Leaving them unset locally is fine
# — the switch fails open, so `npm run dev` always serves the real Landing page.
NEXT_PUBLIC_POSTHOG_KEY=phc_CHANGE_ME
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Neon Postgres — download counter (and later, leaderboards). Optional locally:
# with no URL the count is hidden and downloads are not recorded.
# Apply db/schema.sql once to a new database.
DATABASE_URL=postgres://CHANGE_ME
