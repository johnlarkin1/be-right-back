// Gold queries, authored against symbolic fact labels. `build` resolves these
// to real ROWIDs and emits gold.resolved.jsonl in the schema described in
// docs/casper-rag-eval-plan.md §3.1. Lines starting with // are ignored.
//
// Strata: fact | semantic | temporal_range | superlative | aggregation | recency | cross_contact

{"id": "fact-001", "query": "what's our apartment address", "stratum": "fact", "gold_facts": ["apartment-address"], "metric": "mrr@10", "k": 10, "notes": "Direct lexical-ish match; the easy baseline. If this ever misses, something is structurally broken."}
{"id": "fact-002", "query": "how much is rent", "stratum": "fact", "gold_facts": ["rent-amount"], "hard_negative_facts": ["rent-amount"], "metric": "mrr@10", "k": 10, "notes": "The distractor names the OLD rent (2,400) in a nearby message from the same contact. Gold must outrank it."}
{"id": "fact-003", "query": "when is dad's surgery", "stratum": "fact", "gold_facts": ["dads-surgery"], "contact_scope": "mom", "metric": "mrr@10", "k": 10, "notes": "Contact-scoped. Exercises SearchOptions.contact_id."}
{"id": "fact-004", "query": "where is nina getting married", "stratum": "fact", "gold_facts": ["wedding-venue"], "metric": "mrr@10", "k": 10, "notes": "Venue named once, in one message, 190 days back."}
{"id": "fact-005", "query": "what did the landlord say about the hot water", "stratum": "fact", "gold_facts": ["boiler-broken"], "contact_scope": "theo", "metric": "mrr@10", "k": 10, "notes": "Query says 'hot water'; the answer says 'boiler'. Mild semantic bridge plus a lexical anchor."}

{"id": "sem-001", "query": "what japanese restaurant did we want to try", "stratum": "semantic", "gold_facts": ["nobu-black-cod"], "hard_negative_facts": ["nobu-black-cod"], "metric": "mrr@10", "k": 10, "notes": "No lexical bridge at all: query says 'japanese restaurant', gold says 'black cod at Nobu'. Pure embedding recall. The distractor is a DIFFERENT food spot Maya told us to avoid, so a bag-of-words match ranks it first."}
{"id": "sem-002", "query": "what was that big infrastructure project priya spent forever on", "stratum": "semantic", "gold_facts": ["project-name", "halyard-shipped"], "metric": "recall@10", "k": 10, "notes": "Two-message gold: the naming and the shipping. Message-coverage scoring, per §3.0."}
{"id": "sem-003", "query": "did I ever get promoted", "stratum": "semantic", "gold_facts": ["promotion"], "hard_negative_facts": ["promotion"], "metric": "mrr@10", "k": 10, "notes": "The distractor is Priya's rumor about the promo cycle -- topically adjacent, chronologically earlier, and wrong."}
{"id": "sem-004", "query": "what happened to my dad's old car", "stratum": "semantic", "gold_facts": ["car-sold"], "contact_scope": "dad", "metric": "mrr@10", "k": 10, "notes": "Gold says 'sold the Volvo'; query says 'old car'."}
{"id": "sem-005", "query": "who is moving back to the east coast", "stratum": "semantic", "gold_facts": ["casey-moving-back"], "metric": "mrr@10", "k": 10, "notes": "Gold says 'moving back east ... portland wasn't home'. Rare contact, so this also tests that a low-volume conversation isn't buried by the contact-diversity penalty."}

{"id": "temp-001", "query": "what did we book for the japan trip", "stratum": "temporal_range", "gold_facts": ["ryokan-name"], "expected_plan": {"is_aggregation": false, "prefer_recent": false}, "metric": "mrr@10", "k": 10, "notes": "Answer sits ~460 days back. A recency prior that is too strong will bury it."}
{"id": "temp-002", "query": "what did theo tell me last month about the building", "stratum": "temporal_range", "gold_facts": ["water-shutoff"], "contact_scope": "theo", "expected_plan": {"is_aggregation": false, "prefer_recent": true}, "metric": "mrr@10", "k": 10, "notes": "Planner should extract a temporal range from 'last month'. Two candidate repair messages exist; only the recent one is gold."}

{"id": "super-001", "query": "what's the most expensive meal we've ever had", "stratum": "superlative", "gold_facts": ["most-expensive-meal"], "expected_plan": {"is_aggregation": false, "superlative": "max"}, "metric": "rank_of_argmax@1", "k": 10, "notes": "The message states the superlative explicitly, so this tests superlative detection in the planner rather than numeric reasoning."}
{"id": "super-002", "query": "what's the hardest climb I've done", "stratum": "superlative", "gold_facts": ["first-v7"], "expected_plan": {"is_aggregation": false, "superlative": "max"}, "metric": "rank_of_argmax@1", "k": 10, "notes": "Corpus contains a V6 flash 60 days back and the V7 send 215 days back. Recency bias picks the V6; the correct answer is the older, harder one."}

{"id": "agg-001", "query": "how many times did I talk to priya about work", "stratum": "aggregation", "gold_facts": ["project-name", "halyard-shipped"], "contact_scope": "priya", "expected_plan": {"is_aggregation": true}, "metric": "recall@10", "k": 10, "notes": "Primarily a planner assertion -- is_aggregation must be true. Retrieval gold is the anchor pair."}

{"id": "recent-001", "query": "what's the latest from my landlord", "stratum": "recency", "gold_facts": ["water-shutoff"], "contact_scope": "theo", "expected_plan": {"is_aggregation": false, "prefer_recent": true}, "metric": "rank_of_argmax@1", "k": 10, "notes": "Three landlord threads exist across the timeline; only the newest is correct. Directly tests the recency boost."}
{"id": "recent-002", "query": "what book are we reading next", "stratum": "recency", "gold_facts": ["book-club-pick"], "contact_scope": "harper", "expected_plan": {"is_aggregation": false, "prefer_recent": true}, "metric": "mrr@10", "k": 10, "notes": "29 days back, the most recent Harper message of substance."}

{"id": "cross-001", "query": "who do I go climbing with", "stratum": "cross_contact", "gold_facts": ["first-v7", "gunks-trip"], "gold_contacts": ["maya", "dev", "omar"], "metric": "contact_recall@k", "k": 10, "notes": "Answer is spread across three contacts plus a group chat. Tests that the contact-diversity penalty surfaces breadth instead of collapsing onto whoever texts most."}
{"id": "cross-002", "query": "what's going on with the wedding", "stratum": "cross_contact", "gold_facts": ["wedding-venue"], "gold_contacts": ["nina"], "metric": "contact_recall@k", "k": 10, "notes": "Nina's 1:1 thread carries the venue, but the engagement also appears in the family group chat. Tests 1:1 vs group handling on the agent surface."}
